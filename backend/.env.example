# GROQ: cadastrar em Supabase Edge Function Secrets.
GROQ_API_KEY=gsk_substitua
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REVIEW_MODEL=openai/gpt-oss-20b
GROQ_ENABLE_REVIEW=true

# Lista separada por vírgulas. Não use * em produção.
ALLOWED_ORIGINS=https://seu-frontend.vercel.app

# Proteção de uso e contexto.
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_SECONDS=60
MAX_HISTORY_MESSAGES=12
DATA_RETENTION_DAYS=90

# O Supabase fornece estas variáveis no ambiente hospedado.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
