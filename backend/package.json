{
  "name": "tutor-digital-web-backend",
  "version": "1.2.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Backend Supabase e GROQ do Tutor Digital Personalizado",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:guardrails": "node --experimental-strip-types --test tests/guardrails.test.ts",
    "check:syntax": "node --check --experimental-strip-types supabase/functions/tutor-api/index.ts",
    "check": "deno check supabase/functions/tutor-api/index.ts",
    "test:api": "deno test --allow-env --allow-net tests/api_test.ts"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "deno": "^2.9.6",
    "jsdom": "^30.1.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  }
}
